:root {
  --color-bg: {{tokens.bg}};
  --color-fg: {{tokens.fg}};
  --color-muted: {{tokens.muted}};
  --color-muted-fg: {{tokens.mutedFg}};
  --color-border: {{tokens.border}};
  --color-accent: {{tokens.accent}};
  --color-accent-fg: {{tokens.accentFg}};
  --color-highlight: {{tokens.highlight}};
  --color-highlight-fg: {{tokens.highlightFg}};
  --color-danger: {{tokens.danger}};
  --radius: {{tokens.radius}};
  --font-sans: {{tokens.fontSans}};
  --space-section: {{tokens.spaceSection}};
}

@media (prefers-color-scheme: dark) {
  :root {
    --color-bg: {{tokens.bgDark}};
    --color-fg: {{tokens.fgDark}};
    --color-muted: {{tokens.mutedDark}};
    --color-muted-fg: {{tokens.mutedFgDark}};
    --color-border: {{tokens.borderDark}};
    --color-accent: {{tokens.accentDark}};
    --color-accent-fg: {{tokens.accentFgDark}};
    --color-highlight: {{tokens.highlightDark}};
    --color-highlight-fg: {{tokens.highlightFgDark}};
  }
}
